{
  "Database": {
    "ConnectionString": "Server=localhost;Database=Voyara;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Ai": {
    "MaxConcurrentRequests": 4,
    "OllamaBaseUrl": "http://localhost:11434",
    "Model": "qwen3.5:4b",
    "TimeoutSeconds": 120
  },
  "FileStorage": {
    "RootPath": "file-storage"
  },
  "Jwt": {
    "Issuer": "Voyara",
    "Audience": "Voyara",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

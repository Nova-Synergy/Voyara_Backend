{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=voyara;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Ai": {
    "MaxConcurrentRequests": 4
  },
  "FileStorage": {
    "RootPath": "file-storage"
  },
  "Jwt": {
    "Issuer": "Voyara",
    "Audience": "Voyara",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
